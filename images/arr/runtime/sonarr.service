[Unit]
Description=Sonarr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonarr
Group=arr
ExecStart=/opt/sonarr/Sonarr -nobrowser -data=/var/lib/arr/sonarr
UMask=0007
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arr/sonarr /var/lib/arr/downloads

[Install]
WantedBy=multi-user.target
