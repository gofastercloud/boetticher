[Unit]
Description=Prowlarr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prowlarr
Group=arr
ExecStart=/opt/prowlarr/Prowlarr -nobrowser -data=/var/lib/arr/prowlarr
UMask=0007
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arr/prowlarr

[Install]
WantedBy=multi-user.target
