[Unit]
Description=qBittorrent native download client
After=network-online.target boetticher-arr-peer-firewall.service
Requires=boetticher-arr-peer-firewall.service
Wants=network-online.target
ConditionPathExists=/var/lib/arr/qbittorrent/qBittorrent/config/qBittorrent.conf
ConditionPathExists=/etc/nftables.d/arr-peers.nft

[Service]
Type=simple
User=qbittorrent
Group=arr
ExecStart=/usr/bin/qbittorrent-nox --profile=/var/lib/arr/qbittorrent --webui-port=8080
UMask=0007
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/arr/qbittorrent /var/lib/arr/downloads

[Install]
WantedBy=multi-user.target
