[Unit]
Description=Install temporary Core deployment access and the labadmin key
After=local-fs.target cloud-init.service
Before=ssh.service
[Service]
Type=oneshot
ExecStart=/usr/lib/boetticher/boetticher-first-boot.sh
NoNewPrivileges=no
ProtectSystem=full
ProtectHome=no

[Install]
WantedBy=multi-user.target
