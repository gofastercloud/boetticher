#!/bin/sh
set -eu

credential_dir=/run/credentials/litellm.service
for credential in "$credential_dir"/*; do
  [ -f "$credential" ] || continue
  name=${credential##*/}
  case "$name" in
    ''|*[!A-Za-z0-9._-]*)
      echo "LiteLLM credential name is invalid" >&2
      exit 1
      ;;
  esac
  environment_name=$(printf '%s' "$name" | tr '[:lower:].-' '[:upper:]__')
  value=$(cat "$credential")
  export "LITELLM_SECRET_${environment_name}=$value"
done

exec /usr/bin/setpriv --reuid=litellm --regid=litellm --init-groups /opt/litellm/bin/litellm "$@"
