[Unit]
Description=Boetticher bounded central journal query
After=systemd-journal-remote.service network.target

[Service]
User=boetticher-log-query
Group=boetticher-log-query
SupplementaryGroups=systemd-journal-remote
ExecStart=/usr/local/libexec/boetticher-log-query
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=10.10.20.70
ReadOnlyPaths=/var/log/journal/remote /etc/boetticher-log-query /etc/boetticher/pki /var/lib/boetticher/identity/tls

[Install]
WantedBy=multi-user.target
