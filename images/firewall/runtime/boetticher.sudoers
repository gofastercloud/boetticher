# The managed firewall exposes fixed, read-only inspection operations for
# durable labadmin diagnostics. Deployment still uses temporary root SSH.
labadmin ALL=(root) NOPASSWD: /usr/lib/boetticher/inspect-firewall status, /usr/lib/boetticher/inspect-firewall ruleset, /usr/lib/boetticher/inspect-firewall table, /usr/lib/boetticher/inspect-firewall leases, /usr/lib/boetticher/inspect-firewall ddns-stats, /usr/lib/boetticher/inspect-firewall kernel-logs *
