#cloud-config
hostname: lab-fw-01
manage_etc_hosts: true
users:
  - name: labadmin
    shell: /bin/bash
    ssh_authorized_keys: []
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/sysctl.d/boetticher-forwarding.conf
    permissions: '0644'
    content: |
      net.ipv4.ip_forward=0
      net.ipv6.conf.all.forwarding=0
