[Unit]
Description=Boetticher AIOps incident adapter
After=network-online.target holmes.service
Requires=boetticher-aiops.socket

[Service]
User=boetticher-aiops
Group=boetticher-aiops
ExecStart=/usr/local/libexec/boetticher-aiops
LoadCredential=webhook-secret:/var/lib/boetticher/credentials/aiops-webhook-secret.cred
LoadCredential=pulse-read-token:/var/lib/boetticher/credentials/aiops-pulse-read-token.cred
LoadCredential=pulse-note-token:/var/lib/boetticher/credentials/aiops-pulse-note-token.cred
LoadCredential=loopback-secret:/var/lib/boetticher/credentials/aiops-loopback-secret.cred
LoadCredential=server-cert:/var/lib/boetticher/identity/tls/aiops.crt.pem
LoadCredential=server-key:/var/lib/boetticher/identity/tls/aiops.key.pem
EnvironmentFile=/etc/boetticher-aiops/runtime.env
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.10.10.20
IPAddressAllow=10.10.10.40
IPAddressAllow=10.10.20.60
ReadWritePaths=/var/lib/boetticher/aiops /run/boetticher-aiops
RuntimeDirectory=boetticher-aiops
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
