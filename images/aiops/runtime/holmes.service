[Unit]
Description=HolmesGPT read-only investigation engine
After=network.target

[Service]
User=holmes
Group=holmes
ExecStart=/opt/holmes/bin/python -u /opt/holmes/server.py
Environment=OPENAI_API_BASE=http://127.0.0.1:8444/v1
Environment=OPENAI_API_KEY=boetticher-holmes-active-investigation
Environment=HOLMES_HOST=127.0.0.1
Environment=HOLMES_PORT=8090
Environment=HOLMES_CONFIG_PATH=/etc/boetticher-aiops/holmes.yaml
Environment=HOLMES_DISABLE_STRICT_TOOL_CALLS=false
Environment=HOLMES_TOOL_RESULT_STORAGE_ENABLED=false
Environment=OVERRIDE_MAX_OUTPUT_TOKEN=1200
Environment=TRACE_TOKEN_USAGE=false
Environment=LOG_LEVEL=WARNING
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/etc/boetticher-aiops
RuntimeDirectory=holmes

[Install]
WantedBy=multi-user.target
