server {
    listen 10.10.10.20:443 ssl;
    server_name monitor.lab.home.arpa;

    ssl_certificate /etc/boetticher/tls/monitor.crt.pem;
    ssl_certificate_key /etc/boetticher/tls/monitor.key.pem;
    ssl_client_certificate /etc/boetticher/tls/client-ca.pem;
    ssl_crl /etc/boetticher/tls/client-ca.crl.pem;
    ssl_verify_client optional;
    ssl_verify_depth 3;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Only the explicitly mapped browser identities receive Pulse proxy auth.
    # AIOps and host-agent paths remain token-only and never inherit the
    # shared proxy credential.
    set $boetticher_pulse_proxy_user "";
    set $boetticher_pulse_proxy_role "";
    if ($ssl_client_s_dn = "CN=client-operator.{{ domain }},O=boetticher") {
        set $boetticher_pulse_proxy_user operator;
        set $boetticher_pulse_proxy_role admin;
    }
    if ($ssl_client_s_dn = "CN=client-lab-display-01-kiosk.{{ domain }},O=boetticher") {
        set $boetticher_pulse_proxy_user kiosk;
        set $boetticher_pulse_proxy_role kiosk;
    }
    include /run/boetticher/pulse-proxy-auth.conf;

    # The companion StreamDeck capability and controller read client are read-only and use
    # scoped API tokens. Pulse validates the token and its scope at the application boundary.
    location = /api/health {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Token $http_x_api_token;
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Role "";
    }
    location = /api/state/summary {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Token $http_x_api_token;
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Role "";
    }
    location = /api/resources {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Token $http_x_api_token;
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Role "";
    }

    # Host agents authenticate with their scoped report token. The browser UI
    # and all other monitor routes retain the endpoint's mTLS requirement.
    location ^~ /api/agents/ {
        proxy_pass http://127.0.0.1:7655;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Proxy-Secret "";
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Role "";
    }

    # AIOps uses distinct scoped Pulse bearer tokens. These exact routes expose
    # only the operations those tokens authorize; the catch-all remains mTLS
    # protected for the browser UI.
    location = /api/alerts/active {
        limit_except GET { deny all; }
        set $boetticher_pulse_proxy_secret "";
        if ($boetticher_pulse_proxy_user != "") {
            set $boetticher_pulse_proxy_secret $boetticher_pulse_proxy_shared_secret;
        }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Proxy-Secret $boetticher_pulse_proxy_secret;
        proxy_set_header Remote-User $boetticher_pulse_proxy_user;
        proxy_set_header Remote-Role $boetticher_pulse_proxy_role;
    }
    location = /api/alerts/incidents {
        limit_except GET { deny all; }
        set $boetticher_pulse_proxy_secret "";
        if ($boetticher_pulse_proxy_user != "") {
            set $boetticher_pulse_proxy_secret $boetticher_pulse_proxy_shared_secret;
        }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Proxy-Secret $boetticher_pulse_proxy_secret;
        proxy_set_header Remote-User $boetticher_pulse_proxy_user;
        proxy_set_header Remote-Role $boetticher_pulse_proxy_role;
    }
    location ~ ^/api/resources/[^/]+(?:/metrics)?$ {
        limit_except GET { deny all; }
        set $boetticher_pulse_proxy_secret "";
        if ($boetticher_pulse_proxy_user != "") {
            set $boetticher_pulse_proxy_secret $boetticher_pulse_proxy_shared_secret;
        }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Proxy-Secret $boetticher_pulse_proxy_secret;
        proxy_set_header Remote-User $boetticher_pulse_proxy_user;
        proxy_set_header Remote-Role $boetticher_pulse_proxy_role;
    }
    location = /api/metrics-store/history {
        limit_except GET { deny all; }
        set $boetticher_pulse_proxy_secret "";
        if ($boetticher_pulse_proxy_user != "") {
            set $boetticher_pulse_proxy_secret $boetticher_pulse_proxy_shared_secret;
        }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Proxy-Secret $boetticher_pulse_proxy_secret;
        proxy_set_header Remote-User $boetticher_pulse_proxy_user;
        proxy_set_header Remote-Role $boetticher_pulse_proxy_role;
    }
    location = /api/alerts/incidents/note {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization $http_authorization;
    }

    location / {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-(?:read|note)(?:,|$)") { return 403; }
        if ($boetticher_pulse_proxy_user = "") { return 403; }
        set $boetticher_pulse_proxy_secret $boetticher_pulse_proxy_shared_secret;
        proxy_pass http://127.0.0.1:7655;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Proxy-Secret $boetticher_pulse_proxy_secret;
        proxy_set_header Remote-User $boetticher_pulse_proxy_user;
        proxy_set_header Remote-Role $boetticher_pulse_proxy_role;
    }
}
