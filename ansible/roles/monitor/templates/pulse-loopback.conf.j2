server {
    listen 10.10.10.20:443 ssl;
    server_name monitor.lab.home.arpa;

    ssl_certificate /etc/boetticher/tls/monitor.crt.pem;
    ssl_certificate_key /etc/boetticher/tls/monitor.key.pem;
    ssl_client_certificate /etc/boetticher/tls/client-ca.pem;
    ssl_verify_client optional;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Host agents authenticate with their scoped report token. The browser UI
    # and all other monitor routes retain the endpoint's mTLS requirement.
    location ^~ /api/agents/ {
        proxy_pass http://127.0.0.1:7655;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # AIOps identities are constrained by certificate identity as well as their
    # Pulse token. Exact read locations reject the note identity; the exact note
    # location rejects the read identity. The catch-all below rejects both.
    location = /api/alerts/active {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        limit_except GET { deny all; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-note(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/alerts/incidents {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        limit_except GET { deny all; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-note(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~ ^/api/resources/[^/]+(?:/metrics)?$ {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        limit_except GET { deny all; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-note(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/metrics-store/history {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        limit_except GET { deny all; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-note(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/alerts/incidents/note {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        limit_except POST { deny all; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-read(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        if ($ssl_client_verify != SUCCESS) { return 403; }
        if ($ssl_client_s_dn ~ "CN=aiops-pulse-(?:read|note)(?:,|$)") { return 403; }
        proxy_pass http://127.0.0.1:7655;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
