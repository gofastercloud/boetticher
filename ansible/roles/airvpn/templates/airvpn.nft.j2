{% set peer_port = module_configs.airvpn.qbittorrent_port | default(0) | int %}
{% set forward_arr = '10.10.20.110/32' in (firewall_plan.airvpn_source_cidrs | default([])) and peer_port > 0 %}
destroy table inet boetticher_airvpn
destroy table ip boetticher_airvpn_nat

table inet boetticher_airvpn {
  chain input {
    type filter hook input priority filter; policy drop;
    iifname "lo" accept comment "boetticher:airvpn-input-loopback"
    ct state established,related accept comment "boetticher:airvpn-input-established"
    iifname "eth0" ip saddr 10.10.99.5 tcp dport 22 accept comment "boetticher:airvpn-input-managed-ssh"
  }

  chain output {
    type filter hook output priority filter; policy drop;
    oifname "lo" accept comment "boetticher:airvpn-output-loopback"
    ct state established,related accept comment "boetticher:airvpn-output-established"
{% for address in firewall_plan.airvpn.endpoint_addresses %}
    oifname "eth0" ip daddr {{ address }} udp dport {{ firewall_plan.airvpn.endpoint_port }} accept comment "boetticher:airvpn-provider-handshake-{{ loop.index }}"
{% endfor %}
    oifname "eth0" ip daddr { {{ dns_plan.nameservers | join(', ') }} } tcp dport 53 accept comment "boetticher:airvpn-dns-tcp"
    oifname "eth0" ip daddr { {{ dns_plan.nameservers | join(', ') }} } udp dport { 53, 123 } accept comment "boetticher:airvpn-dns-ntp-udp"
    oifname "airvpn0" accept comment "boetticher:airvpn-output-tunnel"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept comment "boetticher:airvpn-forward-established"
{% if forward_arr %}
    iifname "airvpn0" oifname "eth0" ip daddr 10.10.20.110 meta l4proto { tcp, udp } th dport {{ peer_port }} ct status dnat accept comment "boetticher:arr-forwarded-peer"
{% endif %}
{% if firewall_plan.airvpn_source_cidrs | default([]) | length > 0 %}
    iifname "eth0" oifname "airvpn0" ip saddr { {{ firewall_plan.airvpn_source_cidrs | join(', ') }} } accept comment "boetticher:airvpn-selected-sources"
{% endif %}
    iifname "eth0" oifname "eth0" drop comment "boetticher:airvpn-no-direct-forward"
    iifname "eth0" drop comment "boetticher:airvpn-no-internal-forward"
  }
}

table ip boetticher_airvpn_nat {
{% if forward_arr %}
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "airvpn0" meta l4proto { tcp, udp } th dport {{ peer_port }} dnat to 10.10.20.110 comment "boetticher:arr-peer-dnat"
  }
{% endif %}
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
{% if forward_arr %}
    iifname "airvpn0" oifname "eth0" ip daddr 10.10.20.110 meta l4proto { tcp, udp } th dport {{ peer_port }} ct status dnat snat to 10.10.5.20 comment "boetticher:arr-peer-return-path"
{% endif %}
{% if firewall_plan.airvpn_source_cidrs | default([]) | length > 0 %}
    oifname "airvpn0" ip saddr { {{ firewall_plan.airvpn_source_cidrs | join(', ') }} } masquerade comment "boetticher:airvpn-payload-nat"
{% endif %}
  }
}
