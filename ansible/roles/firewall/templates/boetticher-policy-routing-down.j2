#!/bin/sh
set -eu
for priority in $(ip -4 rule show | awk '$NF == {{ firewall_plan.policy_routes[0].table }} {gsub(":", "", $1); print $1}'); do
  ip -4 rule del priority "$priority"
done
route_status=0
route_output=$(ip -4 route flush table {{ firewall_plan.policy_routes[0].table }} 2>&1) || route_status=$?
if [ "$route_status" -ne 0 ] && ! printf '%s\n' "$route_output" | grep -Fq 'FIB table does not exist'; then
  printf '%s\n' "$route_output" >&2
  exit "$route_status"
fi
