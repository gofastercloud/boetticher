#!/bin/sh
set -eu
# Stopping the routing unit must not restore direct-WAN access. Leave lookup
# and unreachable rules installed until an explicitly reviewed policy change.
ip -4 route replace unreachable default metric 32767 table {{ firewall_plan.policy_routes[0].table }}
ip -4 route del default via {{ firewall_plan.policy_routes[0].default_gateway }} dev {{ firewall_plan.policy_routes[0].default_interface }} metric 100 table {{ firewall_plan.policy_routes[0].table }} 2>/dev/null || true
