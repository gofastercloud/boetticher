{
  "DhcpDdns": {
    "ip-address": "127.0.0.1",
    "port": 53001,
    "control-socket": { "socket-type": "unix", "socket-name": "/run/kea/kea-ddns-ctrl-socket" },
    "dns-server-timeout": 500,
    "ncr-protocol": "UDP",
    "ncr-format": "JSON",
    "tsig-keys": [
{% for zone in firewall_plan.ddns.zones %}
      {"name": "{{ zone.tsig_key_name }}", "secret-file": "/run/credentials/kea-dhcp-ddns-server.service/kea-ddns-tsig", "algorithm": "{{ firewall_plan.dhcp_subnets[loop.index0].tsig_algorithm }}"}{% if not loop.last %},{% endif %}
{% endfor %}
    ],
    "forward-ddns": {
      "ddns-domains": [
{% for zone in firewall_plan.ddns.zones %}
      {"name": "{{ zone.forward_zone }}", "key-name": "{{ zone.tsig_key_name }}", "dns-servers": [{"ip-address": "10.10.10.10", "port": 5353}]}{% if not loop.last %},{% endif %}
{% endfor %}
      ]
    },
    "reverse-ddns": {
      "ddns-domains": [
{% for zone in firewall_plan.ddns.zones %}
      {"name": "{{ zone.reverse_zone }}", "key-name": "{{ zone.tsig_key_name }}", "dns-servers": [{"ip-address": "10.10.10.10", "port": 5353}]}{% if not loop.last %},{% endif %}
{% endfor %}
      ]
    }
  }
}
