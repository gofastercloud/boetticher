#!/bin/sh
set -eu
export LC_ALL=C
# This runs only after the new restrictive rules load, while forwarding is
# disabled. It never restores a previous permissive ruleset.
for source in 10.10.40.0/24 {{ firewall_plan.airvpn_source_cidrs | default([]) | join(' ') }}; do
  for direction in -s -d; do
    status=0
    output=$(conntrack -D -f ipv4 "$direction" "$source" 2>&1) || status=$?
    if [ "$status" -ne 0 ]; then
      if [ "$status" -ne 1 ] || ! printf '%s\n' "$output" | grep -Fq '0 flow entries have been deleted'; then
        echo 'restricted connection-state invalidation failed' >&2
        exit 1
      fi
    fi
  done
done
ip -4 neigh flush dev sandbox0
