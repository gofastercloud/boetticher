# Generated by boetticher. Composite interfaces are ignored: only the parent
# usb_device can enqueue reconciliation.
{% for manifest in usb_export_manifests %}
{% for export in manifest.exports %}
ACTION=="add|remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="{{ export.port }}", RUN+="/bin/systemctl --no-block start boetticher-usb-export@{{ manifest.vmid }}.service"
{% endfor %}
{% endfor %}
