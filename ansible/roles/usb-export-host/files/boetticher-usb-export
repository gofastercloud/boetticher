#!/usr/bin/python3
"""Reconcile Core-declared USB exports for one owned LXC.

The manifest, never the caller, supplies paths and targets. Every caller for a
VMID serializes on one lock and reconciles the complete desired set before a
single optional restart.
"""
import fcntl
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile
import time

MANIFEST_DIR = Path("/etc/boetticher/usb-exports")
STATE_DIR = Path("/var/lib/boetticher/usb-export")
SYS_USB = Path("/sys/bus/usb/devices")
DEV_ROOT = Path("/dev")
DEV_USB = Path("/dev/bus/usb")
LOCK_DIR = Path("/run/lock")
MAX_BYTES = 1024 * 1024

class Hold(RuntimeError): pass

def run(*args):
    result = subprocess.run(args, check=False, text=True, capture_output=True)
    if result.returncode:
        raise Hold(f"command failed ({' '.join(args)}): {result.stderr.strip()[:500]}")
    return result.stdout

def run_result(*args):
    return subprocess.run(args, check=False, text=True, capture_output=True)

def load_json(path):
    data = path.read_bytes()
    if len(data) > MAX_BYTES: raise Hold(f"oversized JSON file: {path}")
    return json.loads(data)

def pct_config(vmid):
    values = {}
    for line in run("pct", "config", str(vmid)).splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip()] = value.strip()
    return values

def validate_guest(manifest, config):
    if config.get("hostname") != manifest["hostname"]: raise Hold("guest hostname does not match manifest")
    tags = set(config.get("tags", "").replace(";", " ").split())
    if manifest["ownership_tag"] not in tags or "boetticher" not in tags or "managed" not in tags: raise Hold("guest ownership tags do not match manifest")
    if config.get("unprivileged", "0") != "1" or not manifest.get("unprivileged"): raise Hold("USB export target must be unprivileged")

def checked_character_device(path, root):
    try:
        st = path.stat()
    except FileNotFoundError:
        return None
    resolved = path.resolve()
    resolved_root = root.resolve()
    if (resolved_root != resolved and resolved_root not in resolved.parents) or not stat.S_ISCHR(st.st_mode):
        raise Hold(f"resolved device is not a character device below {root}")
    return str(path)

def serial_device(parent):
    for _ in range(26):
        names = sorted({candidate.name for candidate in parent.glob("**/tty*") if candidate.name.startswith(("ttyUSB", "ttyACM")) and candidate.name[6:].isdigit()})
        devices = [DEV_ROOT / name for name in names if (DEV_ROOT / name).exists()]
        if len(devices) > 1:
            raise Hold(f"multiple serial devices found below USB port {parent.name}")
        if devices:
            return checked_character_device(devices[0], DEV_ROOT)
        time.sleep(0.2)
    return None

def resolve(export):
    parent = SYS_USB / export["port"]
    if not parent.is_dir(): return None
    try:
        vendor_id = (parent / "idVendor").read_text().strip().lower()
        product_id = (parent / "idProduct").read_text().strip().lower()
        expected_serial = export.get("serial", "")
        actual_serial = (parent / "serial").read_text().strip() if (parent / "serial").exists() else ""
    except FileNotFoundError:
        return None
    if vendor_id != export["vendor_id"]: raise Hold(f"VID mismatch at USB port {export['port']}")
    if product_id != export["product_id"]: raise Hold(f"PID mismatch at USB port {export['port']}")
    if expected_serial and actual_serial != expected_serial: raise Hold(f"serial mismatch at USB port {export['port']}")
    device_type = export.get("device_type")
    if device_type == "serial":
        return serial_device(parent)
    if device_type != "raw-usb":
        raise Hold(f"unsupported USB device type: {device_type}")
    bus, device = int((parent / "busnum").read_text()), int((parent / "devnum").read_text())
    return checked_character_device(DEV_USB / f"{bus:03d}" / f"{device:03d}", DEV_USB)

def device_values(config):
    return {key: value for key, value in config.items() if key.startswith("dev") and key[3:].isdigit()}

def device_path(value): return value.split(",", 1)[0]

def guest_devices_present(vmid, values):
    for value in values.values():
        path = device_path(value)
        result = run_result("pct", "exec", str(vmid), "--", "test", "-c", path)
        if result.returncode == 0:
            continue
        if result.returncode == 1:
            return False
        raise Hold(f"could not verify guest USB device {path}: {result.stderr.strip()[:500]}")
    return True

def desired_values(manifest):
    result = {}
    for export in manifest["exports"]:
        path = resolve(export)
        if path:
            result[export["slot"]] = f"{path},uid=2200,gid=2200,mode=0660"
    return result

def atomic_state(vmid, values):
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    payload = json.dumps({"vmid": vmid, "managed": values}, sort_keys=True, separators=(",", ":")) + "\n"
    fd, temporary = tempfile.mkstemp(prefix=f".{vmid}.", dir=STATE_DIR)
    try:
        os.fchmod(fd, 0o600); os.write(fd, payload.encode()); os.fsync(fd); os.close(fd)
        os.replace(temporary, STATE_DIR / f"{vmid}.json")
        directory = os.open(STATE_DIR, os.O_DIRECTORY); os.fsync(directory); os.close(directory)
    finally:
        try: os.close(fd)
        except OSError: pass
        try: os.unlink(temporary)
        except FileNotFoundError: pass

def reconcile(manifest_path):
    manifest = load_json(manifest_path); vmid = int(manifest["vmid"])
    lock_path = LOCK_DIR / f"boetticher-usb-export-{vmid}.lock"
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        current = pct_config(vmid); validate_guest(manifest, current)
        desired = desired_values(manifest)
        existing = device_values(current)
        state_path = STATE_DIR / f"{vmid}.json"
        recorded = load_json(state_path).get("managed", {}) if state_path.exists() else {}
        managed_slots = set(manifest["managed_slots"])
        static_slots = set(manifest.get("static_slots", []))
        if managed_slots & static_slots: raise Hold("USB manifest overlaps static and managed device slots")
        for slot, value in existing.items():
            if slot in managed_slots and slot not in recorded and value != desired.get(slot):
                raise Hold(f"occupied {slot} cannot be proven Core-managed")
            if slot not in managed_slots and slot in recorded:
                raise Hold(f"recorded managed slot {slot} is outside the current manifest")
            if slot not in managed_slots and slot not in static_slots:
                raise Hold(f"occupied {slot} is not declared by the complete Core USB manifest")
        changed = {slot: value for slot, value in existing.items() if slot in managed_slots} != desired
        running = False
        if changed:
            # The lock covers every deletion, update, verification and restart.
            for slot in sorted(managed_slots):
                if slot in existing and slot not in desired: run("pct", "set", str(vmid), "--delete", slot)
            for slot, value in sorted(desired.items()):
                if existing.get(slot) != value: run("pct", "set", str(vmid), f"--{slot}", value)
            verified_config = pct_config(vmid); validate_guest(manifest, verified_config)
            verified = {slot: value for slot, value in device_values(verified_config).items() if slot in managed_slots}
            if verified != desired: raise Hold("post-change verification did not produce the complete desired USB mapping")
            running = run("pct", "status", str(vmid)).strip().endswith("running")
        elif desired:
            # Proxmox can retain the correct config while a running LXC has a
            # stale device namespace. Verify the guest view before declaring
            # an unchanged export converged.
            running = run("pct", "status", str(vmid)).strip().endswith("running")
            if running and not guest_devices_present(vmid, desired):
                run("pct", "reboot", str(vmid))
                running = False
        atomic_state(vmid, desired)
        if changed and running:
            run("pct", "reboot", str(vmid))

def remove_manifest(vmid):
    if vmid <= 0: raise Hold("VMID must be positive")
    LOCK_DIR.mkdir(parents=True, exist_ok=True, mode=0o755)
    lock_path = LOCK_DIR / f"boetticher-usb-export-{vmid}.lock"
    with lock_path.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        _remove_manifest_locked(vmid)

def _remove_manifest_locked(vmid):
    manifest_path = MANIFEST_DIR / f"{vmid}.json"
    state_path = STATE_DIR / f"{vmid}.json"
    if manifest_path.exists():
        manifest = load_json(manifest_path)
        if int(manifest.get("vmid", -1)) != vmid:
            raise Hold("USB manifest VMID does not match its filename")
        manifest_path.unlink()
    if state_path.exists():
        state = load_json(state_path)
        if int(state.get("vmid", -1)) != vmid:
            raise Hold("USB state VMID does not match its filename")
        state_path.unlink()

def main(argv):
    if len(argv) == 2 and argv[0] == "--remove":
        remove_manifest(int(argv[1]))
        return
    paths = sorted(MANIFEST_DIR.glob("*.json")) if argv == ["--all"] else [MANIFEST_DIR / f"{int(argv[0])}.json"] if len(argv) == 1 else []
    if argv == ["--all"] and not paths: return
    if not paths: raise Hold("usage: boetticher-usb-export VMID | --all | --remove VMID")
    for path in paths:
        if not path.is_file(): raise Hold(f"missing USB export manifest: {path}")
        reconcile(path)

if __name__ == "__main__":
    try: main(sys.argv[1:])
    except (Hold, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"HOLD: USB export reconciliation refused: {error}", file=sys.stderr); raise SystemExit(2)
