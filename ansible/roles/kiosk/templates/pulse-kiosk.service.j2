[Unit]
Description=Boetticher Pulse dashboard Chromium kiosk
After=seatd.service boetticher-companion.service systemd-user-sessions.service dbus.socket getty@tty1.service
Requires=seatd.service
Wants=boetticher-companion.service dbus.socket
Before=graphical.target
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video render kiosk-seat companion
WorkingDirectory=/home/kiosk
Environment=HOME=/home/kiosk
Environment=XDG_RUNTIME_DIR=/run/kiosk
Environment=LIBSEAT_BACKEND=seatd
Environment=WLR_LIBINPUT_NO_DEVICES=1
Environment=WLR_RENDERER=pixman
Environment=XDG_CONFIG_HOME=/home/kiosk/.config
Environment=XDG_CACHE_HOME=/home/kiosk/.cache
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStartPre=/usr/local/libexec/boetticher-companion ready
ExecStart=/usr/bin/cage -- /usr/bin/chromium --kiosk --no-first-run --no-default-browser-check --noerrdialogs --disable-session-crashed-bubble --disable-pinch --ozone-platform=wayland --user-data-dir=/home/kiosk/.config/chromium-kiosk http://127.0.0.1:8765/
Restart=always
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kiosk/.cache /home/kiosk/.config
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
