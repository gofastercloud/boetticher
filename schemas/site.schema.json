{
  "$defs": {
    "DHCPReservation": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "mac": {
          "type": "string"
        },
        "vmid": {
          "type": "integer"
        },
        "zone": {
          "type": "string"
        }
      },
      "required": [
        "zone",
        "hostname",
        "address",
        "mac"
      ],
      "type": "object"
    },
    "DNSModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "blocky",
          "enum": [
            "blocky",
            "adguard"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "Gateway": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "external"
          ],
          "type": "string"
        },
        "publish": {
          "items": {
            "$ref": "#/$defs/GatewayPublication"
          },
          "type": "array"
        },
        "upstream": {
          "$ref": "#/$defs/GatewayUpstream"
        }
      },
      "required": [
        "mode",
        "upstream"
      ],
      "type": "object"
    },
    "GatewayPublication": {
      "additionalProperties": false,
      "properties": {
        "service": {
          "enum": [
            "dns"
          ],
          "type": "string"
        }
      },
      "required": [
        "service"
      ],
      "type": "object"
    },
    "GatewayUpstream": {
      "additionalProperties": false,
      "properties": {
        "mac": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "dhcp"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode",
        "mac"
      ],
      "type": "object"
    },
    "LiteLLMModelConfig": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "upstream": {
          "type": "string"
        }
      },
      "required": [
        "alias",
        "upstream",
        "model"
      ],
      "type": "object"
    },
    "LiteLLMModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/LiteLLMModelConfig"
          },
          "type": "array"
        },
        "upstreams": {
          "items": {
            "$ref": "#/$defs/LiteLLMUpstreamConfig"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LiteLLMUpstreamConfig": {
      "additionalProperties": false,
      "properties": {
        "api_key_secret": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "base_url",
        "api_key_secret"
      ],
      "type": "object"
    },
    "MandatoryModuleConfig": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "ModulesConfig": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "$ref": "#/$defs/DNSModuleConfig"
        },
        "firewall": {
          "$ref": "#/$defs/ToggleModuleConfig"
        },
        "litellm": {
          "$ref": "#/$defs/LiteLLMModuleConfig"
        },
        "logging": {
          "$ref": "#/$defs/MandatoryModuleConfig"
        },
        "monitoring": {
          "$ref": "#/$defs/ToggleModuleConfig"
        },
        "streamdeck": {
          "$ref": "#/$defs/StreamDeckModuleConfig"
        },
        "tailnet-router": {
          "$ref": "#/$defs/ToggleModuleConfig"
        }
      },
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "type": "array"
        }
      },
      "required": [
        "domain",
        "zones"
      ],
      "type": "object"
    },
    "OwnershipPolicy": {
      "additionalProperties": false,
      "properties": {
        "module_guest_id_max": {
          "type": "integer"
        },
        "module_guest_id_min": {
          "type": "integer"
        },
        "platform_guest_id_max": {
          "type": "integer"
        },
        "platform_guest_id_min": {
          "type": "integer"
        },
        "user_guest_id_max": {
          "type": "integer"
        },
        "user_guest_id_min": {
          "type": "integer"
        },
        "user_workloads_managed": {
          "type": "boolean"
        }
      },
      "required": [
        "platform_guest_id_min",
        "platform_guest_id_max",
        "module_guest_id_min",
        "module_guest_id_max",
        "user_guest_id_min",
        "user_guest_id_max",
        "user_workloads_managed"
      ],
      "type": "object"
    },
    "PKIMetadata": {
      "additionalProperties": false,
      "properties": {
        "issuing_common_name": {
          "type": "string"
        },
        "issuing_expiry": {
          "type": "string"
        },
        "issuing_fingerprint": {
          "type": "string"
        },
        "root_common_name": {
          "type": "string"
        },
        "root_expiry": {
          "type": "string"
        },
        "root_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "root_common_name",
        "root_fingerprint",
        "root_expiry",
        "issuing_common_name",
        "issuing_fingerprint",
        "issuing_expiry"
      ],
      "type": "object"
    },
    "PhysicalNIC": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pci_address": {
          "type": "string"
        },
        "permanent_mac": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "PhysicalNetwork": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "virtual-only",
            "physical-trunk"
          ],
          "type": "string"
        },
        "trunk": {
          "$ref": "#/$defs/PhysicalNIC"
        },
        "upstream": {
          "$ref": "#/$defs/PhysicalNIC"
        }
      },
      "required": [
        "upstream",
        "trunk",
        "mode"
      ],
      "type": "object"
    },
    "SecretMetadata": {
      "additionalProperties": false,
      "properties": {
        "age_recipient": {
          "type": "string"
        },
        "installation_id": {
          "type": "string"
        }
      },
      "required": [
        "installation_id",
        "age_recipient"
      ],
      "type": "object"
    },
    "StreamDeckModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "brightness": {
          "default": 40,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "default_page": {
          "default": "overview",
          "enum": [
            "overview",
            "guests"
          ],
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "pinned_guests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "refresh_seconds": {
          "default": 5,
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 3,
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "storage_critical_percent": {
          "default": 90,
          "maximum": 100,
          "minimum": 2,
          "type": "integer"
        },
        "storage_warning_percent": {
          "default": 80,
          "maximum": 99,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "TestedVersions": {
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "string"
        },
        "pulse": {
          "type": "string"
        }
      },
      "required": [
        "gateway",
        "pulse"
      ],
      "type": "object"
    },
    "ToggleModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "USBExportBinding": {
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "product_id": {
          "type": "string"
        },
        "requirement": {
          "type": "string"
        },
        "serial": {
          "type": "string"
        },
        "vendor_id": {
          "type": "string"
        }
      },
      "required": [
        "module",
        "requirement",
        "port",
        "vendor_id",
        "product_id"
      ],
      "type": "object"
    },
    "UserDNSRecord": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "address_mode": {
          "type": "string"
        },
        "dns_addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gateway": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "ntp_addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "enum": [
            "transit",
            "infrastructure",
            "servers",
            "trusted",
            "sandbox",
            "management"
          ],
          "type": "string"
        },
        "vlan": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "type",
        "vlan",
        "network",
        "gateway",
        "address_mode",
        "dns_addresses",
        "ntp_addresses"
      ],
      "type": "object"
    }
  },
  "$id": "https://boetticher.dev/schemas/site.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "boetticher/v3",
      "type": "string"
    },
    "bootstrap_address": {
      "type": "string"
    },
    "dhcp_reservations": {
      "items": {
        "$ref": "#/$defs/DHCPReservation"
      },
      "type": "array"
    },
    "dns_records": {
      "items": {
        "$ref": "#/$defs/UserDNSRecord"
      },
      "type": "array"
    },
    "gateway": {
      "$ref": "#/$defs/Gateway"
    },
    "modules": {
      "$ref": "#/$defs/ModulesConfig"
    },
    "network": {
      "$ref": "#/$defs/Network"
    },
    "ownership": {
      "$ref": "#/$defs/OwnershipPolicy"
    },
    "physical_network": {
      "$ref": "#/$defs/PhysicalNetwork"
    },
    "pki": {
      "$ref": "#/$defs/PKIMetadata"
    },
    "platform_version": {
      "const": "0.3.34",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "secret_metadata": {
      "$ref": "#/$defs/SecretMetadata"
    },
    "ssh_identity_file": {
      "type": "string"
    },
    "storage_device": {
      "type": "string"
    },
    "storage_profile": {
      "enum": [
        "single-disk",
        "dedicated-data-disk"
      ],
      "type": "string"
    },
    "tested_versions": {
      "$ref": "#/$defs/TestedVersions"
    },
    "usb_exports": {
      "items": {
        "$ref": "#/$defs/USBExportBinding"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version"
  ],
  "title": "boetticher v3 SiteConfig",
  "type": "object"
}
