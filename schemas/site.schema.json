{
  "$id": "https://boetticher.dev/schemas/site.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "boetticher/v3"
    },
    "bootstrap_address": {
      "type": "string"
    },
    "gateway": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "external"
          ]
        }
      },
      "type": "object"
    },
    "modules": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "blocky",
                "adguard"
              ]
            }
          },
          "type": "object"
        },
        "firewall": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        },
        "monitoring": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "ownership": {
      "type": "object"
    },
    "physical_network": {
      "type": "object"
    },
    "pki": {
      "type": "object"
    },
    "platform_version": {
      "const": "0.3.1"
    },
    "proxmox_node": {
      "type": "string"
    },
    "schema_version": {
      "const": 3
    },
    "secret_metadata": {
      "type": "object"
    },
    "ssh_identity_file": {
      "type": "string"
    },
    "storage_device": {
      "type": "string"
    },
    "storage_profile": {
      "enum": [
        "single-disk",
        "dedicated-data-disk"
      ]
    },
    "tested_versions": {
      "type": "object"
    }
  },
  "required": [
    "api_version"
  ],
  "title": "boetticher v3 SiteConfig",
  "type": "object"
}
