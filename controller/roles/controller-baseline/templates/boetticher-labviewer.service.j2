[Unit]
Description=Boetticher Lab snapshot portal
After=local-fs.target network-online.target
Wants=network-online.target
RequiresMountsFor=/etc/boetticher /opt/boetticher/current

[Service]
Type=simple
User=root
ExecStart=/opt/boetticher/current/bin/boetticher-labviewer --lab /etc/boetticher/lab.yml --listen 10.10.20.10:8090 --snapshot-dir /var/lib/boetticher/labviewer/snapshot --facts /var/lib/boetticher/labviewer/facts.json --docs-root /opt/boetticher/current/controller/labviewer/docs --snapshot-interval 5m
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/boetticher/lab.yml /opt/boetticher/current/controller/labviewer/docs
ReadWritePaths=/var/lib/boetticher/labviewer/snapshot
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
