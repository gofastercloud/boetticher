[Unit]
Description=Pulse dashboard Chromium kiosk
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
WorkingDirectory=/home/kiosk
Environment=HOME=/home/kiosk
Environment=XDG_RUNTIME_DIR=/run/kiosk
Environment=LIBSEAT_BACKEND=seatd
Environment=XDG_CONFIG_HOME=/home/kiosk/.config
Environment=XDG_CACHE_HOME=/home/kiosk/.cache
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/cage -- /usr/bin/chromium --kiosk --no-first-run --no-default-browser-check --noerrdialogs --disable-session-crashed-bubble --disable-infobars --disable-pinch --overscroll-history-navigation=0 --disable-features=Translate --ozone-platform=wayland --user-data-dir=/home/kiosk/.config/chromium-kiosk --disable-extensions-except=/home/kiosk/pulse-refresh-extension --load-extension=/home/kiosk/pulse-refresh-extension https://monitor.lab.home.arpa
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/home/kiosk/.cache /home/kiosk/.config
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077

[Install]
WantedBy=multi-user.target
