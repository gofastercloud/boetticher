[Unit]
Description=Boetticher Bifrost Holmes backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bifrost
Group=bifrost
Environment=BIFROST_LISTEN=127.0.0.1:4000
LoadCredential=holmes-client-token:/var/lib/boetticher/credentials/holmes-client-token.cred
ExecStart=/usr/local/libexec/boetticher-bifrost serve --config /etc/boetticher/bifrost/config.json
Restart=on-failure
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
