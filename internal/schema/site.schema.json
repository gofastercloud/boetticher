{
  "$defs": {
    "DNSModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "blocky",
          "enum": [
            "blocky",
            "adguard"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "Gateway": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "managed",
            "external"
          ],
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "MandatoryModuleConfig": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "ModulesConfig": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "$ref": "#/$defs/DNSModuleConfig"
        },
        "firewall": {
          "$ref": "#/$defs/ToggleModuleConfig"
        },
        "logging": {
          "$ref": "#/$defs/MandatoryModuleConfig"
        },
        "monitoring": {
          "$ref": "#/$defs/ToggleModuleConfig"
        }
      },
      "type": "object"
    },
    "Network": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/Zone"
          },
          "type": "array"
        }
      },
      "required": [
        "domain",
        "zones"
      ],
      "type": "object"
    },
    "OwnershipPolicy": {
      "additionalProperties": false,
      "properties": {
        "module_guest_id_max": {
          "type": "integer"
        },
        "module_guest_id_min": {
          "type": "integer"
        },
        "platform_guest_id_max": {
          "type": "integer"
        },
        "platform_guest_id_min": {
          "type": "integer"
        },
        "user_guest_id_max": {
          "type": "integer"
        },
        "user_guest_id_min": {
          "type": "integer"
        },
        "user_workloads_managed": {
          "type": "boolean"
        }
      },
      "required": [
        "platform_guest_id_min",
        "platform_guest_id_max",
        "module_guest_id_min",
        "module_guest_id_max",
        "user_guest_id_min",
        "user_guest_id_max",
        "user_workloads_managed"
      ],
      "type": "object"
    },
    "PKIMetadata": {
      "additionalProperties": false,
      "properties": {
        "issuing_common_name": {
          "type": "string"
        },
        "issuing_expiry": {
          "type": "string"
        },
        "issuing_fingerprint": {
          "type": "string"
        },
        "root_common_name": {
          "type": "string"
        },
        "root_expiry": {
          "type": "string"
        },
        "root_fingerprint": {
          "type": "string"
        }
      },
      "required": [
        "root_common_name",
        "root_fingerprint",
        "root_expiry",
        "issuing_common_name",
        "issuing_fingerprint",
        "issuing_expiry"
      ],
      "type": "object"
    },
    "PhysicalNIC": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "pci_address": {
          "type": "string"
        },
        "permanent_mac": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "PhysicalNetwork": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "virtual-only",
            "physical-trunk"
          ],
          "type": "string"
        },
        "trunk": {
          "$ref": "#/$defs/PhysicalNIC"
        },
        "upstream": {
          "$ref": "#/$defs/PhysicalNIC"
        }
      },
      "required": [
        "upstream",
        "trunk",
        "mode"
      ],
      "type": "object"
    },
    "SecretMetadata": {
      "additionalProperties": false,
      "properties": {
        "age_recipient": {
          "type": "string"
        },
        "installation_id": {
          "type": "string"
        }
      },
      "required": [
        "installation_id",
        "age_recipient"
      ],
      "type": "object"
    },
    "TestedVersions": {
      "additionalProperties": false,
      "properties": {
        "gateway": {
          "type": "string"
        },
        "zabbix": {
          "type": "string"
        }
      },
      "required": [
        "gateway",
        "zabbix"
      ],
      "type": "object"
    },
    "ToggleModuleConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "address_mode": {
          "type": "string"
        },
        "dns_addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gateway": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "ntp_addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vlan": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "vlan",
        "network",
        "gateway",
        "address_mode",
        "dns_addresses",
        "ntp_addresses"
      ],
      "type": "object"
    }
  },
  "$id": "https://boetticher.dev/schemas/site.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "boetticher/v3",
      "type": "string"
    },
    "bootstrap_address": {
      "type": "string"
    },
    "gateway": {
      "$ref": "#/$defs/Gateway"
    },
    "modules": {
      "$ref": "#/$defs/ModulesConfig"
    },
    "network": {
      "$ref": "#/$defs/Network"
    },
    "ownership": {
      "$ref": "#/$defs/OwnershipPolicy"
    },
    "physical_network": {
      "$ref": "#/$defs/PhysicalNetwork"
    },
    "pki": {
      "$ref": "#/$defs/PKIMetadata"
    },
    "platform_version": {
      "const": "0.3.19",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "type": "integer"
    },
    "secret_metadata": {
      "$ref": "#/$defs/SecretMetadata"
    },
    "ssh_identity_file": {
      "type": "string"
    },
    "storage_device": {
      "type": "string"
    },
    "storage_profile": {
      "enum": [
        "single-disk",
        "dedicated-data-disk"
      ],
      "type": "string"
    },
    "tested_versions": {
      "$ref": "#/$defs/TestedVersions"
    }
  },
  "required": [
    "api_version"
  ],
  "title": "boetticher v3 SiteConfig",
  "type": "object"
}
